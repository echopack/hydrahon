/**
 * Renders `.hydrahon/tables.eco`: one class per table, conforming to
 * `hydrahon::Source`, with one `hydrahon::Term<T>` per column.
 */

namespace hydragen;

public struct Emitter
{
    public const Schema $schema;

    public const function render() : string
    {
        string $out = "// generated by hydragen from #[hydrahon::table] declarations, do not edit\n";
        // types outside any namespace first, before a namespace statement claims the rest
        array<string> $spaces = [''];
        foreach ($this->schema->tables as const &$t) {
            string $s = $t->space();
            bool $seen = false;
            foreach ($spaces as const &$known) {
                if ($known == $s) {
                    $seen = true;
                }
            }
            if (!$seen) {
                $spaces->push($s);
            }
        }
        foreach ($spaces as const &$space) {
            bool $opened = false;
            foreach ($this->schema->tables as const &$t) {
                if ($t->space() != $space) {
                    continue;
                }
                if (!$opened && $space->size() > 0) {
                    $out->append("\nnamespace {$space};\n");
                }
                $opened = true;
                Emitter::table($t, $out);
            }
        }
        return $out;
    }

    private static function table(const Table& $t, string& $out) : void
    {
        string $handle = $t->handle();
        string $from = Names::local($t->qualified);
        string $named = Names::prose($t->name);
        string $schema = '';
        if ($t->schema->size() > 0) {
            $schema = ", $schema: '{$t->schema}'";
        }
        $out->append("\n/**\n * The columns of `{$named}`, from `{$from}`.\n */\n");
        $out->append("public class {$handle} : hydrahon::Source\n{\n");
        foreach ($t->columns as const &$c) {
            string $type = $c->type;
            $out->append("    public const hydrahon::Term<{$type}> ${$c->property};\n");
        }
        $out->append("    private hydrahon::Table $hydrahonTable;\n\n");
        $out->append("    public constructor()\n    {\n");
        $out->append("        $this->hydrahonTable = hydrahon::Table(name: '{$t->name}'{$schema});\n    }\n\n");
        $out->append("    public constructor(alias: string $alias)\n    {\n");
        $out->append("        $this->hydrahonTable = hydrahon::Table(name: '{$t->name}', alias: $alias{$schema});\n    }\n\n");
        $out->append("    /**\n     * The common table expression `$name`, shaped like `{$named}`.\n     */\n");
        $out->append("    public constructor(cte: string $name)\n    {\n");
        $out->append("        $this->hydrahonTable = hydrahon::Table(cte: $name);\n    }\n\n");
        $out->append("    init\n    {\n");
        foreach ($t->columns as const &$c) {
            string $type = $c->type;
            $out->append("        $this->{$c->property} = $this->hydrahonTable->column<{$type}>('{$c->name}');\n");
        }
        $out->append("    }\n\n");
        $out->append("    public const function table() : hydrahon::Table\n    {\n        return $this->hydrahonTable;\n    }\n\n");
        $out->append("    /**\n     * Every column, `{$named}.*`, as a select field.\n     */\n");
        $out->append("    public const function all() : hydrahon::Field\n    {\n        return $this->hydrahonTable->star();\n    }\n}\n");
    }
}
