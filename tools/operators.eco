/*
 * Writes hydrahon's typed operator table.
 *
 * Echo refuses an operator over a bare type parameter and a chained generic method that hands
 * back a reference, so every typed overload is spelled out per value kind. This script owns them:
 * src/operators.eco, src/fn.eco and src/assign.eco in full, and the regions between
 * `// generated: <name>` and `// generated: end` in src/term.eco.
 *
 *     echoc run tools/operators.eco             rewrite the files
 *     echoc run tools/operators.eco -- --check  exit 1 when a file is stale
 */

use std::io;
use std::env;

/**
 * One SQL value kind and what SQL lets it do.
 */
struct Kind
{
    string $type;
    bool $ordered;
    bool $numeric;
    bool $signed;
    bool $integer;

    static function all() : array<Kind>
    {
        return [
            Kind('int64', true, true, true, true),
            Kind('uint64', true, true, false, true),
            Kind('float64', true, true, true, false),
            Kind('Decimal', true, true, true, false),
            Kind('bool', false, false, false, false),
            Kind('string', true, false, false, false),
            Kind('Bytes', true, false, false, false),
            Kind('Date', true, false, false, false),
            Kind('DateTime', true, false, false, false),
            Kind('Time', true, false, false, false),
        ];
    }

    const function maybe() : string
    {
        return "{$this->type}?";
    }
}

/**
 * Collects generated source text.
 */
struct Out
{
    string $text = '';

    function line(const string& $s) : void
    {
        $this->text->append($s);
        $this->text->push(10);
    }

    function blank() : void
    {
        $this->text->push(10);
    }
}

const string HEADER = '// generated by tools/operators.eco, do not edit';

/**
 * One binary operator over `$left` and `$right`, the operand types written out, giving a
 * `Term<$result>`. A nullable right value that is null becomes IS NULL, or IS NOT NULL for `ne`.
 */
function infix(Out& $o, const string& $sym, const string& $op, const string& $left, const string& $right, bool $rightTerm, const string& $result) : void
{
    if ($rightTerm) {
        $o->line("operator (Term<{$left}> $a) {$sym} (Term<{$right}> $b) : Term<{$result}>");
        $o->line('{');
        $o->line("    return Term<{$result}>(binary(.{$op}, own($a->node), own($b->node)));");
        $o->line('}');
        $o->blank();
        return;
    }
    $o->line("operator (Term<{$left}> $a) {$sym} ({$right} $b) : Term<{$result}>");
    $o->line('{');
    // a `?` at the end of the type
    if ($right->byte($right->size() - 1) == 63) {
        $negated = 'false';
        if ($op == 'ne') {
            $negated = 'true';
        }
        $o->line('    if ($b == null) {');
        $o->line("        return Term<{$result}>(isNull({$negated}, own($a->node)));");
        $o->line('    }');
    }
    $o->line('    Value $v = $b;');
    $o->line("    return Term<{$result}>(binary(.{$op}, own($a->node), Node::param(mv $v)));");
    $o->line('}');
    $o->blank();
}

/**
 * One unary operator over `$arg`, giving a `Term<$result>`.
 */
function prefix(Out& $o, const string& $sym, const string& $op, const string& $arg, const string& $result) : void
{
    $o->line("operator {$sym}(Term<{$arg}> $a) : Term<{$result}>");
    $o->line('{');
    $o->line("    return Term<{$result}>(unary(.{$op}, own($a->node)));");
    $o->line('}');
    $o->blank();
}

function operators() : string
{
    Out $o = Out();
    $o->line(HEADER);
    $o->blank();
    $o->line('namespace hydrahon;');
    $o->blank();
    array<string> $eq = ['==', '!='];
    array<string> $eqOps = ['eq', 'ne'];
    array<string> $ord = ['<', '<=', '>', '>='];
    array<string> $ordOps = ['lt', 'le', 'gt', 'ge'];
    array<string> $math = ['+', '-', '*', '/'];
    array<string> $mathOps = ['add', 'sub', 'mul', 'div'];
    array<Kind> $kinds = Kind::all();
    foreach ($kinds as const &$k) {
        string $n = $k->type;
        string $q = $k->maybe();
        $o->line("// {$n}");
        $o->blank();
        usize $i = 0;
        while ($i < 2) {
            infix($o, $eq[$i], $eqOps[$i], $n, $n, false, 'bool');
            infix($o, $eq[$i], $eqOps[$i], $n, $n, true, 'bool');
            infix($o, $eq[$i], $eqOps[$i], $q, $q, false, 'bool');
            infix($o, $eq[$i], $eqOps[$i], $q, $q, true, 'bool');
            infix($o, $eq[$i], $eqOps[$i], $q, $n, true, 'bool');
            infix($o, $eq[$i], $eqOps[$i], $n, $q, true, 'bool');
            $i = $i + 1;
        }
        if ($k->ordered) {
            $i = 0;
            while ($i < 4) {
                infix($o, $ord[$i], $ordOps[$i], $n, $n, false, 'bool');
                infix($o, $ord[$i], $ordOps[$i], $n, $n, true, 'bool');
                infix($o, $ord[$i], $ordOps[$i], $q, $n, false, 'bool');
                infix($o, $ord[$i], $ordOps[$i], $q, $q, true, 'bool');
                infix($o, $ord[$i], $ordOps[$i], $q, $n, true, 'bool');
                infix($o, $ord[$i], $ordOps[$i], $n, $q, true, 'bool');
                $i = $i + 1;
            }
        }
        if ($k->numeric) {
            array<string> $syms = $math;
            array<string> $ops = $mathOps;
            if ($k->integer) {
                // integer division truncates on every dialect, MySQL spells it DIV
                $ops[3] = 'quot';
                $syms[] = '%';
                $ops[] = 'mod';
            }
            $i = 0;
            while ($i < $syms->count()) {
                // a divisor column may hold zero, which MySQL and SQLite answer with NULL; a
                // literal zero fails the render instead
                string $quotient = $n;
                if ($syms[$i] == '/' || $syms[$i] == '%') {
                    $quotient = $q;
                }
                infix($o, $syms[$i], $ops[$i], $n, $n, false, $n);
                infix($o, $syms[$i], $ops[$i], $n, $n, true, $quotient);
                infix($o, $syms[$i], $ops[$i], $q, $n, false, $q);
                infix($o, $syms[$i], $ops[$i], $q, $q, true, $q);
                infix($o, $syms[$i], $ops[$i], $q, $n, true, $q);
                infix($o, $syms[$i], $ops[$i], $n, $q, true, $q);
                $i = $i + 1;
            }
        }
        array<string> $both = [$n, $q];
        if ($k->signed) {
            foreach ($both as const &$t) {
                prefix($o, '-', 'neg', $t, $t);
            }
        }
        if ($n == 'string') {
            foreach ($both as const &$t) {
                $o->line("operator(100, left) (Term<{$t}> $a) like (string $pattern) : Term<bool>");
                $o->line('{');
                $o->line('    Value $v = $pattern;');
                $o->line('    return Term<bool>(binary(.like, own($a->node), Node::param(mv $v)));');
                $o->line('}');
                $o->blank();
            }
        }
        foreach ($both as const &$t) {
            $o->line("operator(100, left) (Term<{$t}> $a) in (array<{$n}> $items) : Term<bool>");
            $o->line('{');
            $o->line('    array<Node> $nodes = arr::room<Node>($items->count());');
            $o->line('    foreach ($items as const &$item) {');
            $o->line('        Value $v = $item;');
            $o->line('        $nodes[] = Node::param(mv $v);');
            $o->line('    }');
            $o->line('    return Term<bool>(inList(own($a->node), mv $nodes));');
            $o->line('}');
            $o->blank();
        }
    }
    $o->line('// logic');
    $o->blank();
    array<string> $bools = ['bool', 'bool?'];
    foreach ($bools as const &$l) {
        foreach ($bools as const &$r) {
            infix($o, '&&', 'and', $l, $r, true, 'bool');
            infix($o, '||', 'or', $l, $r, true, 'bool');
        }
        prefix($o, '!', 'not', $l, 'bool');
    }
    return $o->text;
}

/**
 * One typed catalog function: `$name($args) : Term<$result>` over the call `$fn`.
 */
function call(Out& $o, const string& $name, const string& $arg, const string& $result, const string& $fn) : void
{
    $o->line("public function {$name}(hydrahon::Term<{$arg}> $x) : hydrahon::Term<{$result}>");
    $o->line('{');
    $o->line("    return hydrahon::Term<{$result}>(hydrahon::call(.{$fn}, [hydrahon::own($x->node)]));");
    $o->line('}');
    $o->blank();
}

function functions() : string
{
    Out $o = Out();
    $o->line(HEADER);
    $o->blank();
    $o->line('namespace hydrahon::fn;');
    $o->blank();
    $o->line('/**');
    $o->line(' * `COUNT(*)`, every row.');
    $o->line(' */');
    $o->line('public function count() : hydrahon::Term<int64>');
    $o->line('{');
    $o->line('    return hydrahon::Term<int64>(.countAll);');
    $o->line('}');
    $o->blank();
    $o->line('/**');
    $o->line(' * `COUNT(x)`, the rows where `$x` is not null.');
    $o->line(' */');
    $o->line('public function count(hydrahon::Expr $x) : hydrahon::Term<int64>');
    $o->line('{');
    $o->line('    return hydrahon::Term<int64>(hydrahon::call(.count, [hydrahon::own($x->node)]));');
    $o->line('}');
    $o->blank();
    $o->line('/**');
    $o->line(' * `COUNT(DISTINCT x)`.');
    $o->line(' */');
    $o->line('public function countDistinct(hydrahon::Expr $x) : hydrahon::Term<int64>');
    $o->line('{');
    $o->line('    return hydrahon::Term<int64>(hydrahon::call(.countDistinct, [hydrahon::own($x->node)]));');
    $o->line('}');
    $o->blank();
    $o->line('/**');
    $o->line(' * `CURRENT_TIMESTAMP`.');
    $o->line(' */');
    $o->line('public function now() : hydrahon::Term<hydrahon::DateTime>');
    $o->line('{');
    $o->line('    return hydrahon::Term<hydrahon::DateTime>(hydrahon::call(.now, array<hydrahon::Node>()));');
    $o->line('}');
    $o->blank();
    array<Kind> $kinds = Kind::all();
    foreach ($kinds as const &$k) {
        string $n = qualified($k->type);
        string $q = "{$n}?";
        if ($k->numeric) {
            call($o, 'sum', $n, $q, 'sum');
            call($o, 'sum', $q, $q, 'sum');
            string $mean = 'float64?';
            if ($k->type == 'Decimal') {
                $mean = $q;
            }
            call($o, 'avg', $n, $mean, 'avg');
            call($o, 'avg', $q, $mean, 'avg');
        }
        if ($k->signed) {
            call($o, 'abs', $n, $n, 'abs');
            call($o, 'abs', $q, $q, 'abs');
        }
        // postgres orders bytea but has no MIN or MAX over it
        if ($k->ordered && $k->type != 'Bytes') {
            call($o, 'min', $n, $q, 'min');
            call($o, 'min', $q, $q, 'min');
            call($o, 'max', $n, $q, 'max');
            call($o, 'max', $q, $q, 'max');
        }
        if ($k->type == 'string') {
            call($o, 'lower', $n, $n, 'lower');
            call($o, 'lower', $q, $q, 'lower');
            call($o, 'upper', $n, $n, 'upper');
            call($o, 'upper', $q, $q, 'upper');
            call($o, 'length', $n, 'int64', 'length');
            call($o, 'length', $q, 'int64?', 'length');
        }
        $o->line("public function coalesce(hydrahon::Term<{$q}> $x, {$n} $fallback) : hydrahon::Term<{$n}>");
        $o->line('{');
        $o->line('    hydrahon::Value $v = $fallback;');
        $o->line("    return hydrahon::Term<{$n}>(hydrahon::call(.coalesce, [hydrahon::own($x->node), hydrahon::Node::param(mv $v)]));");
        $o->line('}');
        $o->blank();
        $o->line("public function coalesce(hydrahon::Term<{$q}> $x, hydrahon::Term<{$n}> $fallback) : hydrahon::Term<{$n}>");
        $o->line('{');
        $o->line("    return hydrahon::Term<{$n}>(hydrahon::call(.coalesce, [hydrahon::own($x->node), hydrahon::own($fallback->node)]));");
        $o->line('}');
        $o->blank();
        $o->line("public function coalesce(hydrahon::Term<{$q}> $x, hydrahon::Term<{$q}> $fallback) : hydrahon::Term<{$q}>");
        $o->line('{');
        $o->line("    return hydrahon::Term<{$q}>(hydrahon::call(.coalesce, [hydrahon::own($x->node), hydrahon::own($fallback->node)]));");
        $o->line('}');
        $o->blank();
    }
    return $o->text;
}

function qualified(const string& $type) : string
{
    if ($type->byte(0) >= 65 && $type->byte(0) <= 90) {
        return "hydrahon::{$type}";
    }
    return $type;
}

/**
 * Implicit conversions from every typed term into `$target`, which has a one-node constructor.
 */
function conversions(const string& $target) : string
{
    Out $o = Out();
    $o->line(str::concat('    ', HEADER));
    array<Kind> $kinds = Kind::all();
    foreach ($kinds as const &$k) {
        array<string> $both = [$k->type, $k->maybe()];
        foreach ($both as const &$t) {
            $o->blank();
            $o->line('    #[implicit]');
            $o->line("    public static function from(Term<{$t}> $t) : {$target}");
            $o->line('    {');
            $o->line("        return {$target}(own($t->node));");
            $o->line('    }');
        }
    }
    return $o->text;
}

/**
 * One `[column] = value` operator of a `Values`: `$column` and `$value` are the types written
 * out, `$valueTerm` says the value is an expression of type `$value` rather than a plain value.
 */
function assigner(Out& $o, const string& $column, const string& $value, bool $valueTerm) : void
{
    $o->blank();
    if ($valueTerm) {
        $o->line("operator (Values& $s)[const Term<{$column}>& $column] = (Term<{$value}> $value) : void");
        $o->line('{');
        $o->line('    $s->put($column->node, own($value->node));');
        $o->line('}');
        return;
    }
    $o->line("operator (Values& $s)[const Term<{$column}>& $column] = ({$value} $value) : void");
    $o->line('{');
    $o->line('    Value $v = $value;');
    $o->line('    $s->put($column->node, Node::param(mv $v));');
    $o->line('}');
}

/**
 * The typed `[column] = value` operators that fill a `Values` from a map literal, one set per
 * value kind: a plain value, or an expression of the column's type.
 */
function assigners() : string
{
    Out $o = Out();
    $o->line(HEADER);
    $o->blank();
    $o->line('namespace hydrahon;');
    array<Kind> $kinds = Kind::all();
    foreach ($kinds as const &$k) {
        string $n = $k->type;
        string $q = $k->maybe();
        assigner($o, $n, $n, false);
        assigner($o, $n, $n, true);
        assigner($o, $q, $q, false);
        assigner($o, $q, $q, true);
        assigner($o, $q, $n, true);
    }
    return $o->text;
}

/**
 * `$text` with the lines between `// generated: $name` and the next `// generated: end`
 * replaced by `$body`.
 */
function splice(const string& $text, const string& $name, const string& $body) : string
{
    string $open = "// generated: {$name}\n";
    string $close = '// generated: end';
    usize $at = $text->find($open);
    if ($at == $text->size()) {
        die("missing region '{$name}'");
    }
    usize $from = $at + $open->size();
    usize $to = $text->find($close, $from);
    // back up to the indentation before the end marker
    while ($to > $from && $text->byte($to - 1) == 32) {
        $to = $to - 1;
    }
    string $out = string::from($text->sub(0, $from));
    $out->append($body);
    $out->append(string::from($text->sub($to, $text->size() - $to)));
    return $out;
}

/**
 * Write `$text` to `$path`, or with `$check` report whether it would change. Answers whether the
 * file is stale.
 */
function emit(const string& $path, const string& $text, bool $check) : bool
{
    string $old = io::readfile($path)->or('');
    if ($old == $text) {
        return false;
    }
    if ($check) {
        io::eprintln("stale: {$path}");
        return true;
    }
    guard io::writefile($path, $text);
    echo "wrote {$path}";
    return false;
}

bool $check = false;
foreach (env::argv() as const &$a) {
    if ($a == '--check') {
        $check = true;
    }
}

bool $stale = false;
$stale = emit('src/operators.eco', operators(), $check) || $stale;
$stale = emit('src/fn.eco', functions(), $check) || $stale;

string $term = guard io::readfile('src/term.eco');
$term = splice($term, 'expr', conversions('Expr'));
$term = splice($term, 'field', conversions('Field'));
$term = splice($term, 'order', conversions('Order'));
$stale = emit('src/term.eco', $term, $check) || $stale;
$stale = emit('src/assign.eco', assigners(), $check) || $stale;

if ($stale) {
    env::exit(1);
}
