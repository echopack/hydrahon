namespace hydrahon;

/**
 * SQLite. `$version` is `sqlite3_libversion_number()` of the library that runs the SQL: upserts
 * need 3.24, RETURNING 3.35, RIGHT and FULL joins 3.39.
 */
public struct Sqlite : Dialect
{
    /**
     * `sqlite3_libversion_number()`, such as 3045000 for 3.45.0. Features newer than this are
     * refused at render time instead of at the server.
     */
    public uint32 $version = 3045000;

    #[docs::hidden]
    public const function quote(const string& $ident, str::text& $out) : void
    {
        quoteWith($ident, 34, $out);
    }

    #[docs::hidden]
    public const function placeholder(usize $n, str::text& $out) : void
    {
        $out->push(63);
    }

    #[docs::hidden]
    public const function unlimited(str::text& $out) : void
    {
        $out->append(' LIMIT -1');
    }

    #[docs::hidden]
    public const function supports(Feature $f) : bool
    {
        return match ($f) {
            Feature::updateLimit => false,
            Feature::updateOrder => false,
            Feature::deleteLimit => false,
            Feature::deleteOrder => false,
            Feature::compoundOrder => false,
            Feature::upsert => $this->version >= 3024000,
            Feature::returning => $this->version >= 3035000,
            Feature::rightJoin => $this->version >= 3039000,
            Feature::fullJoin => $this->version >= 3039000,
            Feature::insertWith => true,
            Feature::updateWith => true,
            Feature::deleteWith => true,
            Feature::starCount => true,
        };
    }

    #[docs::hidden]
    public const function upsert() : UpsertStyle
    {
        return .onConflict;
    }

    #[docs::hidden]
    public const function excluded(const string& $column, str::text& $out) : void
    {
        $out->append('excluded.');
        $this->quote($column, $out);
    }

    #[docs::hidden]
    public const function incoming(str::text& $out) : void
    {
    }

    #[docs::hidden]
    public const function truncate(str::text& $out) : void
    {
        // an unconditional delete is what sqlite's truncate optimization runs
        $out->append('DELETE FROM ');
    }

    #[docs::hidden]
    public const function call(Function $fn, str::text& $out) : void
    {
        if ($fn == Function::length) {
            $out->append('LENGTH');
            return;
        }
        standardName($fn, $out);
    }

    #[docs::hidden]
    public const function symbol(Binary $op, str::text& $out) : void
    {
        $out->append($op->symbol());
    }

    #[docs::hidden]
    public const function syntax() : Syntax
    {
        // no escape character in LIKE unless ESCAPE names one
        return Syntax();
    }
}
