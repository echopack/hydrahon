namespace hydrahon;

/**
 * MySQL 8.0 and later, or MariaDB with `$mariadb`. Upserts refer to the incoming row as
 * `VALUES(col)`, which every version understands; `$rowAlias` switches to `AS new ... new.col`,
 * which MySQL 8.0.19 and later prefer and MariaDB refuses, so MariaDB keeps `VALUES(col)`.
 * Raw SQL is read the way the default SQL mode reads it, with backslash escapes in strings.
 */
public struct Mysql : Dialect
{
    /**
     * Refer to the incoming row as `AS new ... new.col` instead of `VALUES(col)`. MySQL 8.0.19
     * and later.
     */
    public bool $rowAlias = false;

    /**
     * The server is MariaDB, which takes WITH only before SELECT.
     */
    public bool $mariadb = false;

    #[docs::hidden]
    public const function quote(const string& $ident, str::text& $out) : void
    {
        quoteWith($ident, 96, $out);
    }

    #[docs::hidden]
    public const function placeholder(usize $n, str::text& $out) : void
    {
        $out->push(63);
    }

    #[docs::hidden]
    public const function unlimited(str::text& $out) : void
    {
        $out->append(' LIMIT 18446744073709551615');
    }

    #[docs::hidden]
    public const function supports(Feature $f) : bool
    {
        return match ($f) {
            Feature::returning => false,
            Feature::fullJoin => false,
            // WITH only goes before INSERT ... SELECT, inside it
            Feature::insertWith => false,
            Feature::updateWith => !$this->mariadb,
            Feature::deleteWith => !$this->mariadb,
            // a derived table may not repeat a column name, which `*` across a join does
            Feature::starCount => false,
            else => true,
        };
    }

    #[docs::hidden]
    public const function upsert() : UpsertStyle
    {
        return .duplicateKey;
    }

    #[docs::hidden]
    public const function excluded(const string& $column, str::text& $out) : void
    {
        if ($this->aliased()) {
            $out->append('`new`.');
            $this->quote($column, $out);
            return;
        }
        $out->append('VALUES(');
        $this->quote($column, $out);
        $out->push(41);
    }

    #[docs::hidden]
    public const function incoming(str::text& $out) : void
    {
        if ($this->aliased()) {
            $out->append(' AS `new`');
        }
    }

    #[docs::hidden]
    public const function truncate(str::text& $out) : void
    {
        $out->append('TRUNCATE TABLE ');
    }

    #[docs::hidden]
    public const function call(Function $fn, str::text& $out) : void
    {
        standardName($fn, $out);
    }

    #[docs::hidden]
    public const function symbol(Binary $op, str::text& $out) : void
    {
        if ($op == Binary::quot) {
            // `/` yields a DECIMAL fraction here, even between integers
            $out->append(' DIV ');
            return;
        }
        $out->append($op->symbol());
    }

    #[docs::hidden]
    public const function syntax() : Syntax
    {
        return Syntax($backslashes: true, $hashComments: true, $spacedDashes: true, $likeEscape: true);
    }

    private const function aliased() : bool
    {
        return $this->rowAlias && !$this->mariadb;
    }
}
