namespace hydrahon;

/**
 * A clause the chosen dialect cannot express.
 */
public enum Feature
{
    /**
     * RETURNING on insert, update or delete. MySQL refuses it; SQLite needs 3.35.
     */
    case returning;

    /**
     * LIMIT on an UPDATE. MySQL only.
     */
    case updateLimit;

    /**
     * ORDER BY on an UPDATE. MySQL only.
     */
    case updateOrder;

    /**
     * LIMIT on a DELETE. MySQL only.
     */
    case deleteLimit;

    /**
     * ORDER BY on a DELETE. MySQL only.
     */
    case deleteOrder;

    /**
     * RIGHT JOIN. SQLite needs 3.39.
     */
    case rightJoin;

    /**
     * FULL JOIN. MySQL has none; SQLite needs 3.39.
     */
    case fullJoin;

    /**
     * An upsert. SQLite needs 3.24.
     */
    case upsert;

    /**
     * ORDER BY or LIMIT inside one UNION branch. SQLite refuses it.
     */
    case compoundOrder;

    /**
     * WITH in front of an INSERT. MySQL and MariaDB refuse it.
     */
    case insertWith;

    /**
     * WITH in front of an UPDATE. MariaDB refuses it.
     */
    case updateWith;

    /**
     * WITH in front of a DELETE. MariaDB refuses it.
     */
    case deleteWith;

    /**
     * `count()` over DISTINCT or UNION rows that select `*` across a join. MySQL refuses the
     * repeated column names that makes; list the fields instead.
     */
    case starCount;
}

/**
 * A statement that is wrong whatever the dialect.
 */
public enum Problem
{
    /**
     * An insert without a single `row()`.
     */
    case noRows;

    /**
     * An update without a single `set()`.
     */
    case noAssignments;

    /**
     * Insert rows that set different columns.
     */
    case rowShape;

    /**
     * The same column twice in one row, SET or upsert update.
     */
    case duplicateColumn;

    /**
     * An assignment to something that is not a plain column, like `[$u->views + 1 => 3]`,
     * or `excluded()` outside an upsert.
     */
    case notAColumn;

    /**
     * A column of another table where only the target table fits, such as the left side of
     * a SET.
     */
    case foreignColumn;

    /**
     * An upsert update without a conflict target, on Postgres or SQLite, which need one.
     */
    case conflictTarget;

    /**
     * A `conflict()` with neither `update()` nor `ignore()`, or with both.
     */
    case conflictAction;

    /**
     * Raw SQL whose `?` count differs from its params.
     */
    case rawParams;

    /**
     * Division by a literal zero. The servers disagree on what that means, so it never
     * renders.
     */
    case divisionByZero;

    /**
     * A subquery inside an insert reads the target table under its own name, so a column of
     * the target would silently bind to the subquery's row instead.
     */
    case hiddenTarget;
}

/**
 * Why a statement did not render.
 */
public enum Error
{
    /**
     * The statement is fine, but this dialect cannot say it. Another dialect might.
     */
    case unsupported(Feature $feature);

    /**
     * The statement is wrong in every dialect.
     */
    case invalid(Problem $problem);
}

namespace str;

/**
 * The clause, as a reader would name it: `FULL JOIN`.
 */
public function from(const hydrahon::Feature& $f) : string
{
    return match ($f) {
        hydrahon::Feature::returning => 'RETURNING',
        hydrahon::Feature::updateLimit => 'UPDATE with LIMIT',
        hydrahon::Feature::updateOrder => 'UPDATE with ORDER BY',
        hydrahon::Feature::deleteLimit => 'DELETE with LIMIT',
        hydrahon::Feature::deleteOrder => 'DELETE with ORDER BY',
        hydrahon::Feature::rightJoin => 'RIGHT JOIN',
        hydrahon::Feature::fullJoin => 'FULL JOIN',
        hydrahon::Feature::upsert => 'upsert',
        hydrahon::Feature::compoundOrder => 'ORDER BY or LIMIT inside a UNION branch',
        hydrahon::Feature::insertWith => 'WITH before INSERT',
        hydrahon::Feature::updateWith => 'WITH before UPDATE',
        hydrahon::Feature::deleteWith => 'WITH before DELETE',
        hydrahon::Feature::starCount => 'count of DISTINCT or UNION * across a join',
    };
}

/**
 * What is wrong, in a few words.
 */
public function from(const hydrahon::Problem& $p) : string
{
    return match ($p) {
        hydrahon::Problem::noRows => 'insert without rows',
        hydrahon::Problem::noAssignments => 'update without assignments',
        hydrahon::Problem::rowShape => 'insert rows set different columns',
        hydrahon::Problem::duplicateColumn => 'a column is set twice',
        hydrahon::Problem::notAColumn => 'an assignment target is not a column',
        hydrahon::Problem::foreignColumn => 'a column belongs to another table',
        hydrahon::Problem::conflictTarget => 'conflict update needs a target on this dialect',
        hydrahon::Problem::conflictAction => 'conflict without update or ignore',
        hydrahon::Problem::rawParams => 'raw placeholders and params differ in count',
        hydrahon::Problem::divisionByZero => 'division by a literal zero',
        hydrahon::Problem::hiddenTarget => 'a subquery reads the insert target under its table name, which hides the target row',
    };
}

/**
 * `unsupported by this dialect: FULL JOIN` or `invalid statement: insert without rows`. This
 * is what `"{$e}"` prints.
 */
public function from(const hydrahon::Error& $e) : string
{
    match ($e) {
        hydrahon::Error::unsupported($f) => {
            $what = str::from($f);
            return "unsupported by this dialect: {$what}";
        },
        hydrahon::Error::invalid($p) => {
            $what = str::from($p);
            return "invalid statement: {$what}";
        },
    };
    return '';
}
