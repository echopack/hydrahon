/**
 * Builders for conditions whose parts are only known at runtime.
 */
public struct Cond
{
    /**
     * Every condition holds. An empty list is always true.
     */
    public static function all(array<Term<bool>> $parts) : Term<bool>
    {
        return Cond::fold(mv $parts, .and);
    }

    /**
     * At least one condition holds. An empty list is always false.
     */
    public static function any(array<Term<bool>> $parts) : Term<bool>
    {
        return Cond::fold(mv $parts, .or);
    }

    private static function fold(array<Term<bool>> $parts, Binary $op) : Term<bool>
    {
        if ($parts->count() == 0) {
            if ($op == Binary::and) {
                return Term<bool>(.raw('1 = 1', array<Value>()));
            }
            return Term<bool>(.raw('1 = 0', array<Value>()));
        }
        Node $acc = own($parts[0]->node);
        usize $i = 1;
        while ($i < $parts->count()) {
            $acc = binary($op, mv $acc, own($parts[$i]->node));
            $i = $i + 1;
        }
        return Term<bool>(mv $acc);
    }
}
