namespace hydrahon;

/**
 * A typed SQL expression: a column, a function result, arithmetic or a condition. `T` is the Echo
 * type of the value it yields, so the operator table only accepts operands that match.
 * A condition is a `Term<bool>`.
 */
public struct Term<T>
{
    // not const, so a function that owns its term can take the node with `own`
    internal Node $node;

    /**
     * This expression as a select field with an alias.
     */
    public const function named(const string& $alias) : Field
    {
        string? $name = $alias;
        return Field($this->node, $name);
    }

    /**
     * Ascending order on this expression.
     */
    public const function asc() : Order
    {
        return Order($this->node, .asc);
    }

    /**
     * Descending order on this expression.
     */
    public const function desc() : Order
    {
        return Order($this->node, .desc);
    }

    /**
     * `IS NULL`. Comparing with a nullable value that is null at runtime renders the same; a
     * literal `null` is checked by the compiler itself, so it needs this spelling.
     */
    public const function isNull() : Term<bool>
    {
        return Term<bool>(isNull(false, $this->node));
    }

    /**
     * `IS NOT NULL`. The same rule as `isNull()`: a literal `null` needs this spelling, a
     * nullable value that is null at runtime does not.
     */
    public const function isNotNull() : Term<bool>
    {
        return Term<bool>(isNull(true, $this->node));
    }

    /**
     * Whether the value is among the rows of a one column `$query`. A list of values is the
     * `in` operator instead: `$u->id in [1, 2]`.
     */
    public const function in(Select $query) : Term<bool>
    {
        return Term<bool>(inQuery($this->node, rc<Select>(mv $query)));
    }

    /**
     * Whether the value lies between `$low` and `$high`, both included.
     */
    public const function between(T $low, T $high) : Term<bool>
    {
        Value $a = $low;
        Value $b = $high;
        return Term<bool>(between($this->node, Node::param($a), Node::param($b)));
    }
}

