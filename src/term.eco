/**
 * Which way an `Order` sorts.
 */
public enum Direction
{
    case asc;
    case desc;
}

/**
 * One entry of an order by list. A bare term converts to ascending order.
 */
public struct Order
{
    internal Node $node;

    /**
     * Ascending unless `desc()` built it.
     */
    public Direction $direction = Direction::asc;

