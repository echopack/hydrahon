// logic

operator (Term<bool> $a) && (Term<bool> $b) : Term<bool>
{
    return Term<bool>(binary(.and, own($a->node), own($b->node)));
}

operator (Term<bool> $a) || (Term<bool> $b) : Term<bool>
{
    return Term<bool>(binary(.or, own($a->node), own($b->node)));
}

operator (Term<bool> $a) && (Term<bool?> $b) : Term<bool>
{
    return Term<bool>(binary(.and, own($a->node), own($b->node)));
}

operator (Term<bool> $a) || (Term<bool?> $b) : Term<bool>
{
    return Term<bool>(binary(.or, own($a->node), own($b->node)));
}

operator !(Term<bool> $a) : Term<bool>
{
    return Term<bool>(unary(.not, own($a->node)));
}

operator (Term<bool?> $a) && (Term<bool> $b) : Term<bool>
{
    return Term<bool>(binary(.and, own($a->node), own($b->node)));
