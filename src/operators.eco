operator(100, left) (Term<Date> $a) in (array<Date> $items) : Term<bool>
{
    array<Node> $nodes = arr::room<Node>($items->count());
    foreach ($items as const &$item) {
        Value $v = $item;
        $nodes[] = Node::param(mv $v);
    }
    return Term<bool>(inList(own($a->node), mv $nodes));
}

